# Frontend build-time config (Vite).
#
# Local dev: leave this unset. Vite's dev server proxies /api to
# http://localhost:5000 (see vite.config.ts), so the app works with the
# relative "/api" default.
#
# Production, split deployment (frontend on Netlify, backend on Render):
# set this to your deployed backend's URL, including the "/api" suffix,
# in Netlify's Site settings -> Environment variables, then redeploy.
VITE_API_URL=https://your-backend.onrender.com/api
